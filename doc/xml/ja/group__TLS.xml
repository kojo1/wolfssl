</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>size</parametername>
</parameternamelist>
<parameterdescription>
<para>protocol_nameのサイズを表すWord16タイプ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">WOLFSSL_CTX*<sp/>ctx<sp/>=<sp/>WOLFSSL_CTX_new(<sp/>protocol<sp/>method<sp/>);</highlight></codeline>
<codeline><highlight class="normal">WOLFSSL*<sp/>ssl<sp/>=<sp/>WOLFSSL_new(ctx);</highlight></codeline>
<codeline><highlight class="normal">...</highlight></codeline>
<codeline><highlight class="normal">int<sp/>err;</highlight></codeline>
<codeline><highlight class="normal">char*<sp/>protocol_name<sp/>=<sp/>NULL;</highlight></codeline>
<codeline><highlight class="normal">Word16<sp/>protocol_nameSz<sp/>=<sp/>0;</highlight></codeline>
<codeline><highlight class="normal">err<sp/>=<sp/>wolfSSL_ALPN_GetProtocol(ssl,<sp/>&amp;protocol_name,<sp/>&amp;protocol_nameSz);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">if(err<sp/>==<sp/>SSL_SUCCESS){</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Sent<sp/>ALPN<sp/>protocol</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para>TLSX_ALPN_GetRequest </para>
</simplesect>
<simplesect kind="see"><para>tlsx_find.</para>
</simplesect>
</para>
