        <name>wolfSSL_ALPN_GetProtocol</name>
        <param>
          <type>WOLFSSL *</type>
          <declname>ssl</declname>
        </param>
        <param>
          <type>char **</type>
          <declname>protocol_name</declname>
        </param>
        <param>
          <type>unsigned short *</type>
