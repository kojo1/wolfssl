      <memberdef kind="function" id="group__Random_1ga72ffd8b507b3a895af8a6e9996caba86" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_FreeRng</definition>
        <argsstring>(WC_RNG *)</argsstring>
        <name>wc_FreeRng</name>
        <param>
          <type>WC_RNG *</type>
        </param>
        <briefdescription>
<para>DRGBを安全に解放するためにRNGが不要になったときに呼び出される必要があります。ゼロとXfrees RNG-DRBG。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>0 成功について</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG RNGまたはRNG-&gt;DRGB NULL</para>
</simplesect>
<simplesect kind="return"><para>RNG_FAILURE_E DRBを扱うことに失敗しました</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>rng</parametername>
</parameternamelist>
<parameterdescription>
<para>乱数発生器がWC_INITRNで初期化されました</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">RNG<sp/><sp/>rng;</highlight></codeline>
<codeline><highlight class="normal">int<sp/>ret<sp/>=<sp/>wc_InitRng(&amp;rng);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>return<sp/>-1;<sp/>//init<sp/>of<sp/>rng<sp/>failed!</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">int<sp/>ret<sp/>=<sp/>wc_FreeRng(&amp;rng);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>return<sp/>-1;<sp/>//free<sp/>of<sp/>rng<sp/>failed!</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para>wc_InitRngCavium </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Random_1ga1a87307fac65d3c2a47ffb743020f83c" kindref="member">wc_InitRng</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Random_1ga9a289fb3f58f4a5f7e15c2b5a1b0d7c6" kindref="member">wc_RNG_GenerateBlock</ref> </para>
</simplesect>
<simplesect kind="see"><para>WC_RNG_GERERATEBYTE、</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Random_1ga97d6e079d64601341fb14b5926d3d879" kindref="member">wc_RNG_HealthTest</ref> </para>
</simplesect>
