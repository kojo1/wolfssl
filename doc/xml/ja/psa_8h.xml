      <memberdef kind="function" id="group__PSA_1ga49e96c7f54a0adeab54732a72291628c" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wolfSSL_psa_set_private_key_id</definition>
        <argsstring>(struct psa_ssl_ctx *ctx, psa_key_id_t id)</argsstring>
        <name>wolfSSL_psa_set_private_key_id</name>
        <param>
          <type>struct psa_ssl_ctx *</type>
          <declname>ctx</declname>
        </param>
        <param>
          <type>psa_key_id_t</type>
          <declname>id</declname>
        </param>
        <briefdescription>
<para>この関数は、SSLセッションで使用される秘密鍵を設定します。</para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ctx</parametername>
</parameternamelist>
<parameterdescription>
<para>構造体PSA_SSL_CTXへのポインタ</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>id</parametername>
</parameternamelist>
<parameterdescription>
<para>プライベートKEとして使用されるキーのPSA ID</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">//<sp/>Create<sp/>new<sp/>ssl<sp/>session</highlight></codeline>
<codeline><highlight class="normal">WOLFSSL<sp/>*ssl;</highlight></codeline>
<codeline><highlight class="normal">struct<sp/>psa_ssl_ctx<sp/>psa_ctx<sp/>=<sp/>{<sp/>0<sp/>};</highlight></codeline>
<codeline><highlight class="normal">psa_key_id_t<sp/>key_id;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>key<sp/>provisioning<sp/>already<sp/>done</highlight></codeline>
<codeline><highlight class="normal">get_private_key_id(&amp;key_id);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">ssl<sp/>=<sp/>wolfSSL_new(ctx);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(!ssl)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>return<sp/>NULL;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">wolfSSL_psa_set_private_key_id(&amp;psa_ctx,<sp/>key_id);</highlight></codeline>
<codeline><highlight class="normal">wolfSSL_set_psa_ctx(ssl,<sp/>ctx);</highlight></codeline>
</programlisting></para>
