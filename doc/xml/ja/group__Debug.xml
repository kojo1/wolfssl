      <memberdef kind="function" id="group__Debug_1ga42fb87f2b1eb9f76603fc09b03ce94c4" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void wolfSSL_ERR_print_errors_cb</definition>
        <argsstring>(int(*cb)(const char *str, size_t len, void *u), void *u)</argsstring>
        <name>wolfSSL_ERR_print_errors_cb</name>
        <param>
          <type>int(*)(const char *str, size_t len, void *u)</type>
          <declname>cb</declname>
        </param>
        <param>
          <type>void *</type>
          <declname>u</declname>
