      <memberdef kind="function" id="group__Debug_1ga688146c77e8d4b693d81c4a1f295b126" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void wolfSSL_load_error_strings</definition>
        <argsstring>(void)</argsstring>
        <name>wolfSSL_load_error_strings</name>
        <param>
          <type>void</type>
        </param>
        <briefdescription>
<para>この関数は、OpenSSL互換性（SSL_LOAD_ERROR_STRING）のみであり、アクションはありません。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>none リターンはありません</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>none</parametername>
</parameternamelist>
<parameterdescription>
<para>パラメータはありません</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">wolfSSL_load_error_strings();</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__Debug_1gaafd5671d443fa684913ba5955a4eb591" kindref="member">wolfSSL_get_error</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Debug_1ga571185ba1055ab786470f133fe8a4d45" kindref="member">wolfSSL_ERR_error_string</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Debug_1ga508a388e80c30a9925b47fb6077f5bf3" kindref="member">wolfSSL_ERR_error_string_n</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Debug_1ga3f82460752b93314b1ad70acc623135c" kindref="member">wolfSSL_ERR_print_errors_fp</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Debug_1ga688146c77e8d4b693d81c4a1f295b126" kindref="member">wolfSSL_load_error_strings</ref> </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
