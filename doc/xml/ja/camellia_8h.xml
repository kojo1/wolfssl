</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__Camellia_1ga0d651c93c7f81c7fccb5b01d35a009df" kindref="member">wc_CamelliaEncryptDirect</ref> </para>
</simplesect>
</para>
