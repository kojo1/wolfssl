<codeline></codeline>
<codeline><highlight class="normal">byte<sp/>plain[]<sp/><sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>with<sp/>message<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>cipher[sizeof(plain)];</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">if<sp/>(<sp/>wc_Des3_CbcEncrypt(&amp;enc,<sp/>cipher,<sp/>plain,<sp/>sizeof(plain))<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>error<sp/>encrypting<sp/>message</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
