<codeline><highlight class="normal">word32<sp/>len<sp/>=<sp/>sizeof(data);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">if<sp/>((ret<sp/>=<sp/>wc_InitMd2(md2))<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
