      <memberdef kind="function" id="group__wolfCrypt_1ga0a2c6803a9ba6e8ff9cca961cff340a8" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_Hash</definition>
        <argsstring>(enum wc_HashType hash_type, const byte *data, word32 data_len, byte *hash, word32 hash_len)</argsstring>
        <name>wc_Hash</name>
        <param>
          <type>enum wc_HashType</type>
          <declname>hash_type</declname>
        </param>
        <param>
          <type>const byte *</type>
