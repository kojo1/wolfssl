      <memberdef kind="function" id="group__Random_1ga9a289fb3f58f4a5f7e15c2b5a1b0d7c6" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_RNG_GenerateBlock</definition>
        <argsstring>(WC_RNG *rng, byte *b, word32 sz)</argsstring>
        <name>wc_RNG_GenerateBlock</name>
        <param>
          <type>WC_RNG *</type>
          <declname>rng</declname>
        </param>
        <param>
          <type>byte *</type>
          <declname>b</declname>
        </param>
        <param>
          <type>word32</type>
          <declname>sz</declname>
        </param>
        <briefdescription>
<para>擬似ランダムデータのSZバイトを出力にコピーします。必要に応じてRNGを再編成します（ブロッキング）。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>0 成功した</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG 入力はnullまたはszがmax_request_lenを超えています</para>
</simplesect>
<simplesect kind="return"><para>DRBG_CONT_FIPS_E hash_genはdrbg_cont_failureを返しました</para>
</simplesect>
<simplesect kind="return"><para>RNG_FAILURE_E デフォルトエラー。RNGのステータスはもともとOKではなく、またはdrbg_faileeに設定されています</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>rng</parametername>
</parameternamelist>
<parameterdescription>
<para>wc_initrngで初期化された乱数ジェネレーター</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output</parametername>
</parameternamelist>
<parameterdescription>
<para>ブロックがコピーされるバッファー</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sz</parametername>
</parameternamelist>
<parameterdescription>
<para>バイトの出力のサイズ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">RNG<sp/><sp/>rng;</highlight></codeline>
<codeline><highlight class="normal">int<sp/><sp/>sz<sp/>=<sp/>32;</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>block[sz];</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">int<sp/>ret<sp/>=<sp/>wc_InitRng(&amp;rng);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>return<sp/>-1;<sp/>//init<sp/>of<sp/>rng<sp/>failed!</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_RNG_GenerateBlock(&amp;rng,<sp/>block,<sp/>sz);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>return<sp/>-1;<sp/>//generating<sp/>block<sp/>failed!</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para>wc_InitRngCavium, <ref refid="group__Random_1ga1a87307fac65d3c2a47ffb743020f83c" kindref="member">wc_InitRng</ref> </para>
</simplesect>
<simplesect kind="see"><para>WC_RNG_GENERETYBYTE</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Random_1ga72ffd8b507b3a895af8a6e9996caba86" kindref="member">wc_FreeRng</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Random_1ga97d6e079d64601341fb14b5926d3d879" kindref="member">wc_RNG_HealthTest</ref> </para>
</simplesect>
</para>
        </detaileddescription>
