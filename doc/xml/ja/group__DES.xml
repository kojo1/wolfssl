        <definition>int wc_Des3_CbcDecryptWithKey</definition>
        <argsstring>(byte *out, const byte *in, word32 sz, const byte *key, const byte *iv)</argsstring>
        <name>wc_Des3_CbcDecryptWithKey</name>
        <param>
          <type>byte *</type>
          <declname>out</declname>
        </param>
        <param>
          <type>const byte *</type>
          <declname>in</declname>
        </param>
