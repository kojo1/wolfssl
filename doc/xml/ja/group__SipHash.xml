      <memberdef kind="function" id="group__SipHash_1ga62b288e0ec438b90902468bf280cad95" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_SipHash</definition>
        <argsstring>(const unsigned char *key, const unsigned char *in, word32 inSz, unsigned char *out, unsigned char outSz)</argsstring>
        <name>wc_SipHash</name>
        <param>
          <type>const unsigned char *</type>
          <declname>key</declname>
        </param>
        <param>
          <type>const unsigned char *</type>
          <declname>in</declname>
        </param>
        <param>
          <type>word32</type>
          <declname>inSz</declname>
        </param>
        <param>
          <type>unsigned char *</type>
          <declname>out</declname>
        </param>
        <param>
          <type>unsigned char</type>
          <declname>outSz</declname>
        </param>
        <briefdescription>
<para>この機能はSiphashを使用してデータを1ショットして、キーに基づいてMACを計算します。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>0 Macingに成功したときに返されました</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG キーまたはアウトがnullの場合に返されます</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG IS IS NULLとINSZがゼロではないときに返されます</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG Autszが8または1のいずれでもないときに返されます</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>key</parametername>
</parameternamelist>
<parameterdescription>
<para>16バイト配列へのポインタ</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>in</parametername>
</parameternamelist>
<parameterdescription>
<para>マッケージするデータ</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>inSz</parametername>
</parameternamelist>
<parameterdescription>
<para>マイクされるデータのサイズ</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>out</parametername>
</parameternamelist>
<parameterdescription>
<para>MAC値を保持するためのバイト配列</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>outSz</parametername>
</parameternamelist>
<parameterdescription>
<para>MAとして出力するバイト数</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">unsigned<sp/>char<sp/>key[16]<sp/>=<sp/>{<sp/>...<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>data[]<sp/>=<sp/>{<sp/>Data<sp/>to<sp/>be<sp/>MACed<sp/>};</highlight></codeline>
<codeline><highlight class="normal">word32<sp/>len<sp/>=<sp/>sizeof(data);</highlight></codeline>
