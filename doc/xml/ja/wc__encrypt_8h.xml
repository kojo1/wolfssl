</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sz</parametername>
</parameternamelist>
<parameterdescription>
<para>入力バッファのサイズ</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>key</parametername>
</parameternamelist>
<parameterdescription>
<para>暗号化に使用するキーへのポインタ。</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>iv</parametername>
</parameternamelist>
<parameterdescription>
<para>初期化ベクトル</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">byte<sp/>key[]<sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>with<sp/>8<sp/>byte<sp/>key<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>iv[]<sp/><sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>with<sp/>8<sp/>byte<sp/>iv<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>in[]<sp/>=<sp/>{<sp/>//<sp/>Initialize<sp/>with<sp/>plaintext<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>out[sizeof(in)];</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(<sp/>wc_Des_CbcEncryptWithKey(&amp;out,<sp/>in,<sp/>sizeof(in),<sp/>key,<sp/>iv)<sp/>!=<sp/>0)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>error<sp/>encrypting<sp/>message</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__DES_1gae060cdb2d60657b9c38bab3b37cb1c3d" kindref="member">wc_Des_CbcDecryptWithKey</ref> </para>
