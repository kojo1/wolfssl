<codeline><highlight class="normal">word32<sp/>passwordSize<sp/>=<sp/>8;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">byte<sp/>N[]<sp/>=<sp/>{<sp/>};<sp/>//<sp/>Contents<sp/>of<sp/>byte<sp/>array<sp/>N</highlight></codeline>
