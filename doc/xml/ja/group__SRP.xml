<para><simplesect kind="return"><para>none リターンはありません</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>srp</parametername>
</parameternamelist>
<parameterdescription>
<para>終了するSRP構造へのポインタ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
