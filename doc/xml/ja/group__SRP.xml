      <memberdef kind="function" id="group__SRP_1ga7acf63aa2c1a1e2cf9cc1837b2b92ab0" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_SrpSetUsername</definition>
        <argsstring>(Srp *srp, const byte *username, word32 size)</argsstring>
        <name>wc_SrpSetUsername</name>
        <param>
          <type>Srp *</type>
          <declname>srp</declname>
        </param>
        <param>
          <type>const byte *</type>
          <declname>username</declname>
        </param>
        <param>
          <type>word32</type>
          <declname>size</declname>
        </param>
        <briefdescription>
<para>ユーザー名を設定します。この関数は、WC_SRPINITの後に呼び出される必要があります。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>0 ユーザー名は正常に設定されています。</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG: srpまたはusernameがnullの場合に返します。</para>
</simplesect>
<simplesect kind="return"><para>MEMORY_E: SRP-&gt;USERにメモリを割り当てる問題がある場合</para>
</simplesect>
<simplesect kind="return"><para>&lt; 0：エラー</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>srp</parametername>
</parameternamelist>
<parameterdescription>
<para>SRP構造。</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>username</parametername>
</parameternamelist>
<parameterdescription>
<para>ユーザー名を含むバッファー。</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>size</parametername>
</parameternamelist>
<parameterdescription>
<para>バイトのユーザー名サイズ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">Srp<sp/>srp;</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>username[]<sp/>=<sp/>&quot;user&quot;;</highlight></codeline>
<codeline><highlight class="normal">word32<sp/>usernameSize<sp/>=<sp/>4;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">wc_SrpInit(&amp;srp,<sp/>SRP_TYPE_SHA,<sp/>SRP_CLIENT_SIDE);</highlight></codeline>
<codeline><highlight class="normal">if(wc_SrpSetUsername(&amp;srp,<sp/>username,<sp/>usernameSize)<sp/>!=<sp/>0)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Error<sp/>occurred<sp/>setting<sp/>username.</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline><highlight class="normal">wc_SrpTerm(&amp;srp);</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__SRP_1gae8584f826660880783a9603579f856af" kindref="member">wc_SrpInit</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__SRP_1ga20edf7d124ae9ac9b8011c8171f46015" kindref="member">wc_SrpSetParams</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__SRP_1ga72b7e47afb9f716247d22c432480b226" kindref="member">wc_SrpTerm</ref> </para>
</simplesect>
</para>
        </detaileddescription>
