<codeline><highlight class="normal">byte<sp/>clientPubKey[64];</highlight></codeline>
<codeline><highlight class="normal">word32<sp/>clientPubKeySize<sp/>=<sp/>64;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">wc_SrpInit(&amp;server,<sp/>SRP_TYPE_SHA,<sp/>SRP_SERVER_SIDE);</highlight></codeline>
<codeline><highlight class="normal">wc_SrpSetUsername(&amp;server,<sp/>username,<sp/>usernameSize);</highlight></codeline>
<codeline><highlight class="normal">wc_SrpSetParams(&amp;server,<sp/>N,<sp/>sizeof(N),<sp/>g,<sp/>sizeof(g),<sp/>salt,<sp/>sizeof(salt));</highlight></codeline>
<codeline><highlight class="normal">wc_SrpSetVerifier(&amp;server,<sp/>verifier,<sp/>sizeof(verifier));</highlight></codeline>
