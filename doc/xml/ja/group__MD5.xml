      <memberdef kind="function" id="group__MD5_1gab7c2a1abde9ab76e8d2123b89deabcc4" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_InitMd5</definition>
        <argsstring>(wc_Md5 *)</argsstring>
        <name>wc_InitMd5</name>
        <param>
          <type>wc_Md5 *</type>
        </param>
        <briefdescription>
<para>この関数はMD5を初期化します。これはWC_MD5HASHによって自動的に呼び出されます。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>0 初期化に成功したときに返されます。</para>
</simplesect>
<simplesect kind="return"><para>BAD_FUNC_ARG md5構造がヌル値として渡される場合に返されます</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>md5</parametername>
</parameternamelist>
<parameterdescription>
<para>暗号化に使用するMD5構造へのポインタ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">Md5<sp/>md5;</highlight></codeline>
<codeline><highlight class="normal">byte*<sp/>hash;</highlight></codeline>
<codeline><highlight class="normal">if<sp/>((ret<sp/>=<sp/>wc_InitMd5(&amp;md5))<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/>WOLFSSL_MSG(&quot;wc_Initmd5<sp/>failed&quot;);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline><highlight class="normal">else<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/>ret<sp/>=<sp/>wc_Md5Update(&amp;md5,<sp/>data,<sp/>len);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/>if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/>//<sp/>Md5<sp/>Update<sp/>Failure<sp/>Case.</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/>ret<sp/>=<sp/>wc_Md5Final(&amp;md5,<sp/>hash);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>if<sp/>(ret<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>Md5<sp/>Final<sp/>Failure<sp/>Case.</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__MD5_1ga2414467cfbe10dc6b761723fa236f679" kindref="member">wc_Md5Hash</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__MD5_1gae987cf45cb46af01f6f3f373488e38a6" kindref="member">wc_Md5Update</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__MD5_1ga129e1faa6dde2f621ee68d3c102598e8" kindref="member">wc_Md5Final</ref> </para>
</simplesect>
</para>
        </detaileddescription>
