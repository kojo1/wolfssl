      <memberdef kind="function" id="group__MD5_1ga2ab8a0b9d5c8a469a8618461d6563054" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void wc_Md5Free</definition>
        <argsstring>(wc_Md5 *)</argsstring>
        <name>wc_Md5Free</name>
        <param>
          <type>wc_Md5 *</type>
        </param>
        <briefdescription>
<para>MD5構造をリセットします。注：これは、wolfssl_ti_hashが定義されている場合にのみサポートされています。</para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="return"><para>none いいえリターン</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>md5</parametername>
</parameternamelist>
<parameterdescription>
<para>リセットするMD5構造へのポインタ</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">Md5<sp/>md5;</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>data[]<sp/>=<sp/>{<sp/>Data<sp/>to<sp/>be<sp/>hashed<sp/>};</highlight></codeline>
<codeline><highlight class="normal">word32<sp/>len<sp/>=<sp/>sizeof(data);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">if<sp/>((ret<sp/>=<sp/>wc_InitMd5(&amp;md5))<sp/>!=<sp/>0)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>WOLFSSL_MSG(&quot;wc_InitMd5<sp/>failed&quot;);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline><highlight class="normal">else<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>wc_Md5Update(&amp;md5,<sp/>data,<sp/>len);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>wc_Md5Final(&amp;md5,<sp/>hash);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>wc_Md5Free(&amp;md5);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__MD5_1gab7c2a1abde9ab76e8d2123b89deabcc4" kindref="member">wc_InitMd5</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__MD5_1gae987cf45cb46af01f6f3f373488e38a6" kindref="member">wc_Md5Update</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__MD5_1ga129e1faa6dde2f621ee68d3c102598e8" kindref="member">wc_Md5Final</ref> </para>
</simplesect>
</para>
        </detaileddescription>
