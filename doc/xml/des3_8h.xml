      <memberdef kind="function" id="des3_8h_1a471bf2c8a92d9dd8902d936ea453b8a5" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_Des3_CbcEncrypt</definition>
        <argsstring>(Des3 *des, byte *out, const byte *in, word32 sz)</argsstring>
        <name>wc_Des3_CbcEncrypt</name>
        <param>
          <type>Des3 *</type>
          <declname>des</declname>
        </param>
        <param>
          <type>byte *</type>
          <declname>out</declname>
