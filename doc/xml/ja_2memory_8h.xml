</simplesect>
<simplesect kind="see"><para><ref refid="group__Memory_1ga11a7b13821236105c79c9004cf3ca371" kindref="member">XREALLOC</ref></para>
</simplesect>
<simplesect kind="return"><para>pointer If successful, this function returns a pointer to allocated memory. </para>
</simplesect>
<simplesect kind="return"><para>error If there is an error, NULL will be returned.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>size</parametername>
</parameternamelist>
<parameterdescription>
<para>size, in bytes, of the memory to allocate </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>heap</parametername>
</parameternamelist>
<parameterdescription>
<para>heap hint to use for memory. Can be NULL </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>type</parametername>
</parameternamelist>
<parameterdescription>
<para>dynamic type (see DYNAMIC_TYPE_ list in types.h)</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">int*<sp/>tenInts<sp/>=<sp/>(int*)wolfSSL_Malloc(sizeof(int)*10);</highlight></codeline>
</programlisting></para>
