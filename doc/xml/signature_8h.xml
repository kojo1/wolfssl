<parameterdescription>
<para>ECC_KEYやRSAKEYなどのキー構造へのポインタ。 <emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">int<sp/>ret;</highlight></codeline>
<codeline><highlight class="normal">ecc_key<sp/>eccKey;</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//<sp/>Import<sp/>the<sp/>public<sp/>key</highlight></codeline>
<codeline><highlight class="normal">wc_ecc_init(&amp;eccKey);</highlight></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_ecc_import_x963(eccPubKeyBuf,<sp/>eccPubKeyLen,<sp/>&amp;eccKey);</highlight></codeline>
<codeline><highlight class="normal">//<sp/>Perform<sp/>signature<sp/>verification<sp/>using<sp/>public<sp/>key</highlight></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_SignatureVerify(</highlight></codeline>
<codeline><highlight class="normal">WC_HASH_TYPE_SHA256,<sp/>WC_SIGNATURE_TYPE_ECC,</highlight></codeline>
<codeline><highlight class="normal">fileBuf,<sp/>fileLen,</highlight></codeline>
<codeline><highlight class="normal">sigBuf,<sp/>sigLen,</highlight></codeline>
<codeline><highlight class="normal">&amp;eccKey,<sp/>sizeof(eccKey));</highlight></codeline>
<codeline><highlight class="normal">printf(&quot;Signature<sp/>Verification:<sp/>%s</highlight></codeline>
