<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>hash_type</parametername>
</parameternamelist>
<parameterdescription>
<para>&quot;wc_hash_type_sha256&quot;などの &quot;enum wc_hashtype&quot;からのハッシュ型。 </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sig_type</parametername>
</parameternamelist>
