<codeline lineno="42"><highlight class="keywordtype">int</highlight><highlight class="normal"><sp/><sp/><ref refid="asn__public_8h_1af5c9dd81eafddb0b911192d1a559865a" kindref="member">wc_MakeCert</ref>(Cert*<sp/>cert,<sp/></highlight><highlight class="keywordtype">byte</highlight><highlight class="normal">*<sp/>derBuffer,<sp/>word32<sp/>derSz,<sp/>RsaKey*<sp/>rsaKey,</highlight></codeline>
