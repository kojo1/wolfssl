<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__wolfCrypt_1ga5d1e63497a975c3a6c0080e44a84131c" kindref="member">wolfCrypt_Cleanup</ref> </para>
