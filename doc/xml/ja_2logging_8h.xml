<parameternamelist>
<parametername>none</parametername>
</parameternamelist>
<parameterdescription>
<para>No parameters.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">wolfSSL_Debugging_OFF();</highlight></codeline>
</programlisting></para>
<para><simplesect kind="see"><para><ref refid="group__Debug_1ga192a2501d23697c2b56ce26b1af0eb2c" kindref="member">wolfSSL_Debugging_ON</ref> </para>
