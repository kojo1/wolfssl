<codeline><highlight class="normal">byte<sp/>key[64];</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>pass[]<sp/>=<sp/>{<sp/>};<sp/>//<sp/>initialize<sp/>with<sp/>password</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>salt[]<sp/>=<sp/>{<sp/>};<sp/>//<sp/>initialize<sp/>with<sp/>salt</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_PBKDF2(key,<sp/>pass,<sp/>sizeof(pass),<sp/>salt,<sp/>sizeof(salt),<sp/>2048,<sp/>sizeof(key),</highlight></codeline>
<codeline><highlight class="normal">SHA512);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(<sp/>ret<sp/>!=<sp/>0<sp/>)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>error<sp/>deriving<sp/>key<sp/>from<sp/>password</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
