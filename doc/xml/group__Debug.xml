<codeline><highlight class="normal">{<sp/>fprintf((FILE*)u,<sp/>&quot;%-*.*s\n&quot;,<sp/>(int)len,<sp/>(int)len,<sp/>str);<sp/>return<sp/>0;<sp/>}</highlight></codeline>
