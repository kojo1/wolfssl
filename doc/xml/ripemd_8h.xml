      <memberdef kind="function" id="ripemd_8h_1a3c19a3bb9af1cd99490e5dd83ad56d15" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_RipeMdUpdate</definition>
        <argsstring>(RipeMd *ripemd, const byte *data, word32 len)</argsstring>
        <name>wc_RipeMdUpdate</name>
        <param>
          <type>RipeMd *</type>
          <declname>ripemd</declname>
        </param>
        <param>
          <type>const byte *</type>
          <declname>data</declname>
        </param>
        <param>
          <type>word32</type>
