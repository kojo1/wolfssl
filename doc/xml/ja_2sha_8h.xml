</simplesect>
<simplesect kind="see"><para><ref refid="group__SHA_1ga7ff04c6050595b53c468c0135121cd65" kindref="member">wc_ShaFinal</ref></para>
</simplesect>
<simplesect kind="return"><para>0 Returned upon successfully initializing</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>sha</parametername>
</parameternamelist>
<parameterdescription>
<para>pointer to the sha structure to use for encryption</para>
</parameterdescription>
</parameteritem>
</parameterlist>
