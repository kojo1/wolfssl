<codeline></codeline>
<codeline><highlight class="normal">if(<sp/>err<sp/>!=<sp/>0)<sp/>{<sp/>//<sp/>error<sp/>occurred</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>errorMsg<sp/>=<sp/>wc_GetErrorString(err);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__Error_1gaa4ea3747d756f1ff09bb202cc4d931a5" kindref="member">wc_ErrorString</ref> </para>
