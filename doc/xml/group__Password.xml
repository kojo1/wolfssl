<codeline></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_PKCS512_PBKDF(key,<sp/>pass,<sp/>sizeof(pass),<sp/>salt,<sp/>sizeof(salt),<sp/>2048,</highlight></codeline>
<codeline><highlight class="normal">sizeof(key),<sp/>SHA512,<sp/>1);</highlight></codeline>
<codeline><highlight class="normal">if<sp/>(<sp/>ret<sp/>!=<sp/>0<sp/>)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>error<sp/>deriving<sp/>key<sp/>from<sp/>password</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
</parameterdescription>
