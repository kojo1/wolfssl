      <memberdef kind="function" id="dsa_8h_1ac64c42cb5a47dbf85d86175bdc5a6ce9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int wc_DsaKeyToDer</definition>
        <argsstring>(DsaKey *key, byte *output, word32 inLen)</argsstring>
        <name>wc_DsaKeyToDer</name>
        <param>
          <type>DsaKey *</type>
          <declname>key</declname>
        </param>
        <param>
          <type>byte *</type>
          <declname>output</declname>
        </param>
        <param>
          <type>word32</type>
          <declname>inLen</declname>
