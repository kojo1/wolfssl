<codeline><highlight class="normal">int<sp/>ret;</highlight></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>wc_InitDsaKey(&amp;key);<sp/>//<sp/>initialize<sp/>DSA<sp/>key</highlight></codeline>
</programlisting> </para>
</simplesect>
