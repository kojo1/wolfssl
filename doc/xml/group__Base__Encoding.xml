      <memberdef kind="function" id="group__Base__Encoding_1gaabad3b035053b8ffe8fc1bc29cd8ce8d" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int Base64_Encode</definition>
        <argsstring>(const byte *in, word32 inLen, byte *out, word32 *outLen)</argsstring>
        <name>Base64_Encode</name>
        <param>
          <type>const byte *</type>
          <declname>in</declname>
        </param>
        <param>
          <type>word32</type>
          <declname>inLen</declname>
        </param>
        <param>
