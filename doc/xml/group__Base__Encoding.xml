<codeline><highlight class="normal">byte<sp/>decoded[sizeof(encoded)];</highlight></codeline>
<codeline><highlight class="normal">//<sp/>requires<sp/>at<sp/>least<sp/>(sizeof(encoded)<sp/>*<sp/>3<sp/>+<sp/>3)<sp/>/<sp/>4<sp/>room</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">int<sp/>outLen<sp/>=<sp/>sizeof(decoded);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">if(<sp/>Base64_Decode(encoded,sizeof(encoded),<sp/>decoded,<sp/>&amp;outLen)<sp/>!=<sp/>0<sp/>)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>//<sp/>error<sp/>decoding<sp/>input<sp/>buffer</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting> </para>
</parameterdescription>
</parameteritem>
</parameterlist>
