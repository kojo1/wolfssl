<parameterdescription>
<para>pointer to the buffer in which to store the plaintext</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<emphasis>Example</emphasis> <programlisting><codeline><highlight class="normal">byte<sp/>key[]<sp/><sp/><sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>32<sp/>byte<sp/>key<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>iv[]<sp/><sp/><sp/><sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>12<sp/>byte<sp/>key<sp/>};</highlight></codeline>
<codeline><highlight class="normal">byte<sp/>inAAD[]<sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>AAD<sp/>};</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">byte<sp/>cipher[]<sp/><sp/><sp/><sp/>=<sp/>{<sp/>//<sp/>initialize<sp/>with<sp/>received<sp/>ciphertext<sp/>};</highlight></codeline>
